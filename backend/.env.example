# ==============================================================================
# IBVAP — Intelligent Border Video Analysis Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="IBVAP Backend API"
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Configuration (comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Configuration (PostgreSQL with psycopg2)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
# Note: postgresql://<username>:<password>@<host>:<port>/<dbname> is also accepted and normalized.
DATABASE_URL=postgresql+psycopg2://ibvap_user:ibvap_password@localhost:5432/ibvap
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# File Storage Paths (relative to backend root or absolute)
VIDEOS_DIR=../videos
EVIDENCE_DIR=../evidence
